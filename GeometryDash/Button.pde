class Button{

  private float x;
  private float y;
  private float width;
  private float height;
  private String text;

  Button(float x, float y, float width, float height, String text) {
    this.x = x;
    this.y = y;
    this.width = width;
    this.height = height;
    this.text = text;
  }
  
}
